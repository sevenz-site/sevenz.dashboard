# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini direct (https://aistudio.google.com/apikey) — active provider for
# photo → movements extraction ("Importar libreta").
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — parked for now. The code path
# that uses this is still in app/api/extract/route.ts, just not called.
OPENROUTER_API_KEY=

# Mixpanel (Project Settings → Access Keys → Project Token). Used by BOTH
# lib/mixpanel.ts (browser) and lib/mixpanel-server.ts (server actions).
# Missing value = tracking silently does nothing, no error anywhere — so a
# deploy without this set looks identical to one where nobody uses the app.
# Use the Dev project's token in Preview and the Production one in Production,
# otherwise test data lands in the real numbers.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Quién puede abrir /admin. Lista de correos separados por comas, en
# minúsculas. Sin prefijo NEXT_PUBLIC_ a propósito: nunca debe acabar en un
# paquete del navegador.
#
# HACE FALTA EN PREVIEW TAMBIÉN, no solo en Production. Si falta, la lista
# queda vacía y /admin devuelve 404 a todo el mundo — que es el modo de fallo
# correcto ("nadie es admin" antes que "todos lo son"), pero también significa
# que /admin era IMPOSIBLE de abrir en dev. Estuvo así desde que se construyó,
# así que todas sus pantallas se acabaron probando sobre datos reales de
# producción porque no había alternativa. Detectado el 2026-09-15.
#
# Cambiarla NO surte efecto hasta un despliegue nuevo: el guardia la lee al
# cargar el módulo, no en cada visita.
SUPERADMIN_EMAILS=
