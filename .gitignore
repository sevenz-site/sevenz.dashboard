# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# El ejemplo SÍ se versiona: no lleva ni un valor, y es lo único que documenta
# qué variables hacen falta y en qué entorno. Vivía solo en una máquina, así
# que no había nada que recordara que SUPERADMIN_EMAILS hace falta también en
# Preview — y por eso /admin fue imposible de abrir en dev desde que se
# construyó. Un ejemplo que no viaja con el código no documenta nada.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Herramientas locales y temporales, no del proyecto
.claude/launch.json
supabase/.temp/
zz-*.mjs
zz-*.jpeg
